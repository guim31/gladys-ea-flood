{
  "manifest_version": 1,
  "type": "device",
  "name": "Environment Agency Flood",
  "description": {
    "en": "River levels and flood warnings in England, from the Environment Agency.",
    "fr": "Hauteurs des rivières et alertes crues en Angleterre, par l'Environment Agency.",
    "de": "Pegelstände und Hochwasserwarnungen in England, von der Environment Agency.",
    "es": "Niveles de los ríos y avisos de inundación en Inglaterra, de la Environment Agency."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-ea-flood:1.0.0",
